# Copy to ".env" and/or ".env.local" (gitignored) and fill in. Never commit these files, never paste in chat.
# scripts/run-sammi-sql.ps1 loads .env then .env.local (either may define SUPABASE_DB_URL).
#
# For SUPABASE_DB_URL: Dashboard -> Connect (or Database) -> "Connection string" / URI.
# Choose "Session pooler" (host like aws-0-*.pooler.supabase.com, user postgres.<projectref>).
# Do NOT use "Direct" here for local psql on Windows: that is db.….supabase.co:5432 (different link, IPv6 issues).
# Replace [YOUR-PASSWORD] with the database user password (not the anon key).
# If the password has @, #, or %, URL-encode it (e.g. @ -> %40).
#
SUPABASE_DB_URL=postgresql://postgres.[PROJECT]:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Alternative direct (good for one-shot DDL, no pgbouncer):
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.tftkciljzqbiozqfdziv.supabase.co:5432/postgres

# Optional: same project on Vercel — public /api/meteoblue/point and validation cron
# METEOBLUE_API_KEY=
# CRON_SECRET=
# ECOWITT_INGEST_SECRET=   # Ecowitt custom upload → /api/ecowitt/ingest?secret=…
# ADMIN_VALIDATION_TOKEN=   # long random; /admin/validation?token=… (falls back to CRON_SECRET if unset)
